{
  "name": "@tfv/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./testing.ts",
    "./testing-setup": "./testing-setup.ts",
    "./verify-migrations": "./verify-migrations.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate && pnpm run verify-migrations",
    "verify-migrations": "node --env-file-if-exists=../../.env --experimental-strip-types verify-migrations.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@tfv/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
