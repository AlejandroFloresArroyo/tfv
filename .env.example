# Copia este archivo a .env y ajusta lo que necesites.
# `pnpm db:up` levanta una base local que ya coincide con estos valores.

# La pila local de Supabase: `npx supabase start`.
# Trae Postgres con el esquema auth, GoTrue y el resto del stack.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# La base de pruebas. Sin esto se deriva de la de arriba cambiándole el nombre por `tfv_test`, se
# crea sola la primera vez y se migra sola. Sólo hace falta declararla para apuntar a otro servidor.
# TFV_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/tfv_test
DATABASE_POOL_SIZE=10

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

NODE_ENV=development
API_PORT=5000

# ─── Aplicación web ──────────────────────────────────────────────────────────
# El navegador nunca habla con la API directamente: pide a `/api/*` de su propio origen y el
# proceso de Next reenvía. Así no hay peticiones entre orígenes, y con ellas se va la clase entera
# de problemas de cookies que aparece cuando la aplicación y la API viven en dominios distintos.
API_ORIGIN=http://127.0.0.1:5000

# El prefijo bajo el que el navegador ve la API, y **tiene que coincidir con el del reenvío**.
#
# La credencial de renovación viaja con `Path=<prefijo>/auth` para no enviarse en cada petición.
# Sin el prefijo declararía `/auth`, que no es el camino que el navegador pide, y la cookie no se
# enviaría nunca: la renovación fallaría siempre y la sesión se caería al caducar el acceso en
# lugar de renovarse. Dejarlo vacío sólo vale si el navegador llama a la API en su raíz.
COOKIE_PATH_PREFIX=/api

# ─── Documentos ──────────────────────────────────────────────────────────────
#
# Firma los enlaces públicos de los documentos: es lo único que hace impredecible la referencia que
# se comparte con quien no tiene cuenta. **Obligatorio en producción.** Fuera de ella, sin secreto
# se firma con uno al azar por proceso, así que los enlaces dejan de valer al reiniciar el servicio.
# Rotarlo invalida todos los enlaces repartidos, que es la única forma de revocarlos.

# DOCUMENTS_LINK_SECRET=una-frase-larga-de-al-menos-32-caracteres
