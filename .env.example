# Configuración del entorno de desarrollo.
#
# Copia este archivo a `.env` en la raíz del repositorio. El servicio **no arranca** si falta algo:
# la configuración se valida entera al cargar (`apps/api/src/env.ts`).
#
# Los valores de abajo son los de la pila local que levanta `pnpm db:up`. Los que llevan una
# credencial se leen de `pnpm db:status`, que los imprime: **no se escriben en el repositorio**,
# aunque en local sean siempre los mismos.

# ─── Base de datos ───────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Servicio ────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=5000
CORS_ORIGINS=http://localhost:3000

# ─── Almacenamiento de archivos ──────────────────────────────────────────────
#
# La clave de servicio sale de `pnpm db:status`, campo `SERVICE_ROLE_KEY`. Se queda en la API: el
# navegador sólo recibe autorizaciones firmadas para un objeto concreto.

STORAGE_URL=http://127.0.0.1:54321/storage/v1
STORAGE_BUCKET=tfv
# STORAGE_SERVICE_KEY=

# ─── Cobros ──────────────────────────────────────────────────────────────────
#
# Sin secreto, el endpoint de eventos rechaza todo, que es lo correcto mientras no haya procesador.

# PAYMENTS_WEBHOOK_SECRET=
