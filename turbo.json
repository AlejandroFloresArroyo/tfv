{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // `env` y no `passThroughEnv`: estas tres se **hornean** en el build de la web —el reenvío
      // de `/api/*` se resuelve al compilar y se escribe en el manifiesto—, así que además de
      // llegar tienen que entrar en la huella. Declaradas como `passThroughEnv` no contarían para
      // la caché, y un cambio de `API_ORIGIN` reutilizaría el build anterior: el despliegue saldría
      // mudo apuntando al origen viejo, que es el fallo que nadie ve hasta abrirlo a mano.
      "env": ["NODE_ENV", "API_ORIGIN", "NEXT_PUBLIC_SITES_DOMAIN"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "CI",
        "DATABASE_URL",
        "TFV_TEST_DATABASE_URL",
        "STORAGE_URL",
        "STORAGE_BUCKET",
        "STORAGE_PROVIDER",
        "STORAGE_SERVICE_KEY",
        "STORAGE_S3_ENDPOINT",
        "STORAGE_S3_REGION",
        "STORAGE_S3_ACCESS_KEY_ID",
        "STORAGE_S3_SECRET_ACCESS_KEY",
        "STORAGE_S3_PUBLIC_URL",
        "STORAGE_S3_EXPIRES_SECONDS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
